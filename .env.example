# ============================================================
# .env.example — copy to .env and fill in your values
# ============================================================
# Do NOT commit .env to version control.

# ── LLM provider ──────────────────────────────────────────────
PROVIDER=gemini
# gemini | huggingface

GEMINI_API_KEY=
# Required when PROVIDER=gemini

HF_API_KEY=
# Required when PROVIDER=huggingface

MODEL_NAME=models/gemini-flash-lite-latest
# Gemini examples : models/gemini-flash-lite-latest | models/gemini-pro
# HuggingFace     : google/flan-t5-base | etc.

# ── Inference parameters ───────────────────────────────────────
TEMPERATURE=0
MAX_TOKENS=256

# ── Test execution ─────────────────────────────────────────────
TEST_SUITES=sample_data/prompts/hr_questions.yaml
# Comma-separated paths to prompt YAML files.
# Example: TEST_SUITES=suite_a.yaml,suite_b.yaml

EVALUATORS=hallucination,relevance,faithfulness
# Comma-separated evaluator names.
# Available: hallucination | relevance | faithfulness | llm_judge

REPORTS=json,html,pdf
# Comma-separated report formats.
# Available: json | html | pdf

# ── RAG retrieval ──────────────────────────────────────────────
RAG_ENABLED=false
# true  → chunk source documents and retrieve top-k passages as LLM context
# false → pass the full document to the LLM (legacy behaviour)

RAG_TOP_K=3
# Number of chunks to retrieve per question.

RAG_RETRIEVER=tfidf
# Retrieval strategy.
# No extra packages : tfidf | bm25
# Optional packages : sentence_transformer | faiss | chroma
#   pip install sentence-transformers          (sentence_transformer)
#   pip install faiss-cpu sentence-transformers (faiss)
#   pip install chromadb                        (chroma)

# ── Comparison runs ────────────────────────────────────────────
# The list of retrievers to compare is defined in config/comparison.yaml.
# All settings above apply to every comparison run.
# Run: python scripts/compare_runs.py
